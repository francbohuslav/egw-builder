{
  "name": "egw-builder",
  "version": "1.0.1",
  "description": "Scripts for building, testing and release EnergyGateway",
  "main": "index.js",
  "scripts": {
    "start": "node ./index.js -folder ../v3_0",
    "cleanBuild": "node ./index.js -folder ../v3_0 -clear -build",
    "init": "node ./index.js -folder ../v3_0 -init -uid 12-8835-1",
    "last": "node ./index.js -last",
    "info": "node ./index.js -folder ../v6_4 -info",
    "custom6x": "node ./index.js -folder ../v6_4 -uid 12-8835-1 -getversions",
    "custom64": "node ./index.js -folder ../v6_4 -uid 3167-3373-3998-0000 -clear -runDG -initBSg02 -payloadPersistenceStrategy BSg02",
    "buildmr": "node ./index.js -folder ../v6_X -uid 12-8835-1 -buildMRAll",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "author": "Bohuslav Franc",
  "license": "ISC",
  "dependencies": {
    "decompress": "^4.2.1",
    "html-entities": "^2.6.0",
    "xmldom": "^0.6.0",
    "xpath": "^0.0.32"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/decompress": "^4.2.7",
    "@types/node": "^26.6.4",
    "@types/xmldom": "^0.1.34",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
